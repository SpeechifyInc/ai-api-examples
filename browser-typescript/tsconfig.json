{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"noEmit": true,
		"allowImportingTsExtensions": true
	},
	"include": ["client/**/*", "server/**/*", "vite.config.ts"]
}
