{
	"private": true,
	"name": "speechify-browser-streaming",
	"version": "1.0.0",
	"description": "This example demonstrates how to use the Speechify AI API to stream text-to-speech audio natively in the browser.",
	"type": "module",
	"main": "server/server.ts",
	"scripts": {
		"start": "tsx server/server.ts",
		"dev:start": "tsx watch server/server.ts",
		"build": "vite build",
		"dev:build": "vite build --watch",
		"dev": "run-p dev:*"
	},
	"author": "Eugene Mirotin <eugene.mirotin@speechify.com>",
	"license": "MIT",
	"dependencies": {
		"cookie-parser": "^1.4.6",
		"dotenv": "^16.4.5",
		"express": "^4.19.2"
	},
	"devDependencies": {
		"@types/cookie-parser": "^1.4.7",
		"@types/express": "^4.17.21",
		"@types/node": "^22.0.0",
		"npm-run-all": "^4.1.5",
		"tsx": "^4.19.0",
		"typescript": "^5.6.0",
		"vite": "^5.2.12"
	}
}
